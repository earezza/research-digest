// Windows resources for Research Digest: the open-book icon and version details shown in Explorer.
1 ICON "icon/ResearchDigest.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Research Digest"
      VALUE "FileDescription", "Research Digest - live research newsletter"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "ResearchDigest"
      VALUE "OriginalFilename", "ResearchDigest.exe"
      VALUE "ProductName", "Research Digest"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
